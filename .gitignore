# Dependencies
node_modules
server/node_modules

# Build output
dist
dist-ssr
server/dist

# Test coverage
coverage
server/coverage
.nyc_output
*.lcov
test-results
playwright-report

# Logs
logs
server/logs
*.log
npm-debug.log*
# Dev process supervisor state (pidfiles + log files written by scripts/dev)
.dev-logs/

# Environment files. Layout:
#   .workspace/.env(.secrets)?         workspace (dev sandbox), gitignored
#   .env(.secrets)?                    prod runtime, gitignored
#   plus matching .example templates, which ARE committed.
.env
.env.local
.env.*.local
.env.secrets
.workspace/.env
.workspace/.env.secrets
# Allowlist the committed templates
!.env.example
!.env.secrets.example
!.workspace/.env.example
!.workspace/.env.secrets.example

# Database files (persisted via volume or bind mount)
server/data/*.db
server/data/*.sqlite
server/data/*.sqlite3
# SurrealDB RocksDB storage directory -- bind-mounted at runtime, must not
# be committed. The .gitkeep inside server/data/ keeps the parent dir
# tracked.
server/data/surreal/
# Meilisearch index storage directory -- bind-mounted at runtime, must not
# be committed (it is a rebuildable replica of SurrealDB).
server/data/meili/
# Local DB backup snapshots (manual copies of the rocksdb store) -- can be GBs.
tmp_db_bak/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.swp
*.swo

# OS
Thumbs.db

# Claude Code per-machine settings (keep the schema but not the local overrides)
.claude/settings.local.json

# Compose fragment regenerated by ./workspace on every invocation. Holds
# absolute host paths (plugin marketplaces, dotfiles symlink targets) that are
# specific to one machine, so it must never be committed.
.workspace-extra-mounts.yml

# Local WireGuard configs (contain private keys) -- NEVER commit
.vpn/

# Operator notes that must stay off a public repo (infra topology, secrets
# context, ingest apparatus). The rest of project-kb/ is public by design.
project-kb/private/

# --- Machine- and deployment-specific, deliberately untracked -----------------
# These describe one maintainer's VPS and sandbox rather than the project, so
# they are kept out of the public repository. The two Dockerfiles stay: CI
# builds the published images from them.
# Every pattern here is root-anchored with a leading slash. A bare `hooks/`
# matches a directory of that name at ANY depth, which silently excludes
# src/hooks/ -- seven source files the app does not build without. Same trap
# applies to `workspace`, `.claude/` and the two doc names.
/.env.example
/.env.secrets.example
/docker-compose.yml
/docker-compose.override.yml
/docker-compose.prod.yml
/workspace
/scripts/dev
/.workspace/
/.claude/
/.project-instance.json
/hooks/
/DEPLOY.md
/DESIGN.md
