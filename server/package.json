{
  "name": "fixitalia-server",
  "description": "fixitalia backend",
  "private": true,
  "license": "MIT",
  "author": "Rolando Reiner",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx/esm server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "linkedom": "^0.18.13",
    "playwright": "^1.62.1",
    "surrealdb": "^2.0.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
